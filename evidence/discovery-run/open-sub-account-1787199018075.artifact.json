{
  "schemaVersion": "1.0.0",
  "id": "open-sub-account",
  "name": "Open new sub-account and reach confirmation",
  "description": "Searches for a member, opens a new sub-account of the given type and opening deposit, and stops at the confirmation screen without submitting.",
  "version": 1,
  "contentHash": "014f65f226ccce17a30c77f0db4fd76b7da5496929495ebac677053b46bcf69b",
