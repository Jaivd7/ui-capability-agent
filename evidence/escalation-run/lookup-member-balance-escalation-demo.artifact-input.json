        {
          "strategy": "label",
          "text": "Member ID",
          "exact": false,
          "reason": "Member ID textbox"
        }
      ],
      "type": "fill",
      "value": {
        "kind": "param",
        "param": "memberId"
      }
    },
    {
      "id": "step-2",
      "description": "Search button",
      "retryable": false,
      "irreversible": true,
      "frame": [],
      "locator": [
        {
          "strategy": "role",
          "role": "button",
          "name": "Search",
          "exact": false,
          "reason": "Submit search for member"
        }
      ],
      "type": "click"
