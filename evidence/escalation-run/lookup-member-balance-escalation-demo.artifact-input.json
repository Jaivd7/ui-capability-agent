{
  "schemaVersion": "1.0.0",
  "id": "lookup-member-balance-escalation-demo",
  "name": "DEMO ONLY: search step marked irreversible, for escalation evidence",
  "description": "Searches for a member by ID in Meridian Core Banking and extracts their current savings balance.",
  "version": 1,
