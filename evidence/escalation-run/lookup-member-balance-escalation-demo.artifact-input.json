    {
      "id": "step-3",
      "description": "View link for member 1001",
      "retryable": false,
      "irreversible": false,
      "frame": [],
      "locator": [
        {
          "strategy": "role",
          "role": "link",
          "name": "View",
          "exact": false,
          "reason": "Open member record for 1001"
        }
      ],
      "type": "click"
    },
    {
      "id": "step-4",
