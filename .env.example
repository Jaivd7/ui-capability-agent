# Required for discovery only. Replay never calls an LLM.
ANTHROPIC_API_KEY=

# Mock app
MOCK_APP_PORT=4000
# MOCK_APP_BASE_URL=http://localhost:4000
# Session lifetime for the mock app, in ms (default 10 minutes).
# SESSION_TTL_MS=600000

# Set to false to watch the browser during discovery or replay.
# HEADLESS=true

# Dev-only credentials for the mock app's two roles. Fake, local, non-secret
# (see mock-app/data.ts) -- these overrides exist so nothing is hardcoded.
# MOCK_TELLER_USERNAME=teller1
# MOCK_TELLER_PASSWORD=bankdemo123
# MOCK_READONLY_USERNAME=viewer1
# MOCK_READONLY_PASSWORD=bankdemo123

# Dashboard
# DASHBOARD_PORT=4300

# MERIDIAN CORE (the hosted target). Demo operators, no real credentials.
# MERIDIAN_BASE_URL=https://web-sample.interface-hiring.com
# MERIDIAN_TELLER_USERNAME=teller1
# MERIDIAN_TELLER_PASSWORD=password
# MERIDIAN_SUPERVISOR_USERNAME=super1
# MERIDIAN_SUPERVISOR_PASSWORD=password
# MERIDIAN_BRANCH=MAIN-001
